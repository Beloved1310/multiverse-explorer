# Server-only upstream source. Browser queries always use /api/graphql.
RICK_AND_MORTY_GRAPHQL_ENDPOINT=https://rickandmortyapi.com/graphql

# Local PostgreSQL defaults for `docker compose up`. These are development-only
# credentials. Use a managed database URL and a strong secret in deployment.
POSTGRES_USER=multiverse
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=multiverse_explorer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://multiverse:local-development-only@localhost:5432/multiverse_explorer

# Required when implementing ADR 014. Generate a unique high-entropy secret
# for each environment. Never commit a real value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
